# DevelMo environment variables. Copy to .env.local for development; set in
# Vercel for production. Never commit real values. (.gitignore ignores .env*
# but explicitly re-includes this example file.)

# --- Database (required) -----------------------------------------------------
# Postgres connection string. Production: the Neon connection string.
# Local dev: postgres://postgres@localhost:54329/develmo (see HANDOFF §11).
DATABASE_URL=

# Force the Neon serverless HTTP driver even if the URL does not contain
# neon.tech (optional; auto-detected otherwise).
# DATABASE_DRIVER=neon

# --- Auth (required for the admin console) -----------------------------------
# Session and token signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# One-time Owner bootstrap (npm run admin:bootstrap). Unset both afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=

# --- Email (required for invites, resets, notifications) ---------------------
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Alternative delivery to a webhook (optional, existing).
CONTACT_WEBHOOK_URL=

# --- Rate limiting (required in production) ----------------------------------
# Without these the limiter falls back to a database-backed window (dev/test).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (required for uploads) ------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Scheduled tasks (required for scheduled publishing) ---------------------
# Shared secret protecting /api/cron/* route handlers.
CRON_SECRET=

# --- Optional integrations ---------------------------------------------------
# PageSpeed Insights API key for on-demand PSI runs.
PSI_API_KEY=

# Google reCAPTCHA v3 (existing contact-form protection; leave blank to disable).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score cut-off 0.0-1.0, default 0.5.
# RECAPTCHA_MIN_SCORE=0.5

# --- Local testing only ------------------------------------------------------
# Playwright target, e.g. http://localhost:3010
# E2E_BASE_URL=

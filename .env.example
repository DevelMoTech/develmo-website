# DevelMo environment variables. Copy to .env.local for development; set in
# Vercel for production. Never commit real values. (.gitignore ignores .env*
# but explicitly re-includes this example file.)

# --- Database (required) -----------------------------------------------------
# Postgres connection string. Production: the Neon connection string.
# Local dev: postgres://postgres@localhost:54329/develmo (see HANDOFF §11).
DATABASE_URL=

# Force the Neon serverless HTTP driver even if the URL does not contain
# neon.tech (optional; auto-detected otherwise).
# DATABASE_DRIVER=neon

# --- Auth (required for the admin console) -----------------------------------
# Session and token signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=

# One-time Owner bootstrap (npm run admin:bootstrap -- --token <same value>).
# Unset both afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=

# Absolute origin used in invitation, reset and confirmation emails. Optional:
# derived from the request host when unset (set it for local dev, e.g.
# http://localhost:3000).
# ADMIN_BASE_URL=

# --- Email (required for invites, resets, notifications) ---------------------
RESEND_API_KEY=
# Where contact form enquiries are delivered, and the default address told
# about new admin console access requests (editable at /admin/settings/email).
# Default: s.shahzeb8874@gmail.com
CONTACT_TO=
CONTACT_FROM=
# Alternative delivery to a webhook (optional, existing).
CONTACT_WEBHOOK_URL=
# FormSubmit endpoint base (default https://formsubmit.co/ajax). Tests point this at
# an unreachable host to prove a delivery failure never loses an enquiry.
FORMSUBMIT_URL=

# --- Rate limiting (required in production) ----------------------------------
# Without these the limiter falls back to a database-backed window (dev/test).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Media storage -------------------------------------------------------------
# Vercel Blob read-write token. Objects are stored with private access and
# served through /media/<key> on this origin. Unset: files go to ./.data/media
# on local disk (development and tests only, never on Vercel).
BLOB_READ_WRITE_TOKEN=

# --- Scheduled tasks (required for scheduled publishing) ---------------------
# Shared secret protecting /api/cron/* route handlers (at least 16 characters).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Schedule
# /api/cron/publish in the Vercel project settings; the route answers 503
# while this is unset so a misconfiguration is visible.
CRON_SECRET=
# CRON_SECRET also authorises the proxy to read the IP access rule set
# (/api/security/access-rules). Without it the console can still store
# rules, but the proxy cannot read them and enforces nothing.

# --- Optional integrations ---------------------------------------------------
# PageSpeed Insights API key for on-demand PSI runs.
PSI_API_KEY=

# Google reCAPTCHA v3 (existing contact-form protection; leave blank to disable).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score cut-off 0.0-1.0, default 0.5.
# RECAPTCHA_MIN_SCORE=0.5

# --- Local testing only ------------------------------------------------------
# Playwright target, e.g. http://localhost:3010
# E2E_BASE_URL=

# "npm run db:up" starts the local Postgres when it is not listening on the
# port in DATABASE_URL. Only needed when the server lives somewhere other than
# the default D:/Work/Develmo/devtools layout. PG_BIN is the directory holding
# pg_ctl; PG_DATA is the data directory.
# PG_BIN=
# PG_DATA=

# Cloudflare Turnstile (security manager, brief 3.7). The site key is stored
# in the console and is public; only the secret belongs here. Switching
# Turnstile on also needs https://challenges.cloudflare.com added to
# script-src and frame-src in the CSP in next.config.ts.
TURNSTILE_SECRET_KEY=

# Share of public page views that report Core Web Vitals (performance
# manager, brief 3.8). Defaults to 0.25. Set to 1 in development so the
# console has data to show; leave it at the default in production.
NEXT_PUBLIC_VITALS_SAMPLE_RATE=

# --- Set by the platform, not by hand ----------------------------------------
# Vercel injects VERCEL_URL, VERCEL_BRANCH_URL and VERCEL_PROJECT_PRODUCTION_URL
# on every deployment. src/lib/seo/origin.ts trusts them when deriving the
# absolute origin for sitemaps, canonicals and the SEO audit crawler. Do not
# set them yourself.

# Canonical public origin, used when ADMIN_BASE_URL is unset. Defaults to
# https://develmo.com.
# NEXT_PUBLIC_SITE_URL=https://develmo.com

# --- Build-time only ---------------------------------------------------------
# Redirects the Next build output away from .next so a verification build can
# run while "next dev" holds .next/dev open. Local convenience, never set in
# Vercel. See HANDOFF section 10.
# NEXT_DIST_DIR=.next-build
